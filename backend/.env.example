CLOSED_SEND_BY_ME=true

# Integração: notifica o sistema de inadimplência ("último contato") sempre que
# há troca de mensagem (recebida ou enviada) com um contato no WhatsApp; o
# telefone enviado é sempre o do contato/destinatário. Se ambas estiverem
# vazias, a chamada é ignorada silenciosamente.
WPP_RECEIVE_MESSAGE_URL="https://<host>/api/webhooks/wppReceiveMessage"
WPP_RECEIVE_MESSAGE_TOKEN="<shared-secret>"

# Token exigido no webhook POST /webhook/contacts/sync. Se definido, a requisição
# deve enviá-lo no header "x-webhook-token" ou no campo "token" (body/query). Se
# vazio, o endpoint fica sem autenticação (apenas um aviso é logado).
CONTACT_SYNC_TOKEN="<shared-secret>"

GERENCIANET_SANDBOX=false
GERENCIANET_CLIENT_ID=Client_Id_Gerencianet
GERENCIANET_CLIENT_SECRET=Client_Secret_Gerencianet
GERENCIANET_PIX_CERT=certificado-Gerencianet
GERENCIANET_PIX_KEY=chave pix gerencianet